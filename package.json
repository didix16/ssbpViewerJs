{
  "name": "ssbp-viewer-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w @ssbp/core && npm run build -w @ssbp/viewer",
    "typecheck": "npm run build -w @ssbp/core && npm run typecheck -w @ssbp/viewer",
    "test": "npm run build -w @ssbp/core && node --test packages/ssbp/test/*.test.mjs",
    "test:browser": "npm run build -w @ssbp/core && node scripts/browser-smoke.mjs",
    "test:pages": "npm run build && node scripts/pages-smoke.mjs",
    "preview": "npm run preview -w @ssbp/viewer"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "@types/node": "^24.19.2",
    "playwright": "^1.57.0"
  }
}
